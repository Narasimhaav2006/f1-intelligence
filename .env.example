# Copy this file to .env and replace the placeholder values.
# The real .env file must NEVER be committed to Git.

# MongoDB Atlas connection string (we create this in Phase 3)
MONGODB_URI=replace-with-your-atlas-connection-string

# Name of the database
MONGODB_DB_NAME=f1_intelligence

# Websites allowed to call the backend API (the local React dev server)
ALLOWED_ORIGINS=http://localhost:5173